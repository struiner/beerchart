{
  "name": "beer-taxonomy-atlas",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:e2e": "ng serve --configuration development --host 127.0.0.1",
    "check:boundaries": "node tools/check-taxonomy-boundaries.mjs",
    "ecoregions:acquire": "tsx src/app/datasets/ecoregions/tools/acquire-ecoregion-source.mts",
    "ecoregions:generate": "tsx src/app/datasets/ecoregions/tools/generate-ecoregions.mts",
    "ecoregions:check": "tsx src/app/datasets/ecoregions/tools/generate-ecoregions.mts --check",
    "ecoregions:validate-enrichment": "tsx src/app/datasets/ecoregions/tools/validate-ecoregion-enrichment.mts",
    "prebuild": "npm run check:boundaries && npm run ecoregions:check && npm run ecoregions:validate-enrichment",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "taxonomy:validate": "tsx tools/validate-taxonomy.ts"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.62.1",
    "jsdom": "^28.0.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.8.1",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  }
}
