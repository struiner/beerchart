import { existsSync, mkdirSync, readFileSync, writeFileSync } from 'node:fs';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import { bioregionEnrichment } from '../enrichment/bioregions';
import { enrichmentCoverage } from '../enrichment/coverage-manifest';
import { ecoregionEnrichment } from '../enrichment/ecoregions';
import { realmEnrichment } from '../enrichment/realms';
import { subrealmEnrichment } from '../enrichment/subrealms';
import { livingCompositionPartitionByTaxonId } from '../content/living-composition-ownership';
import { ecoregionPartitionByTargetId } from '../content/partition-ownership.generated';

const root = dirname(fileURLToPath(import.meta.url));
const output = join(root, '..', 'content', 'generated');
const check = process.argv.includes('--check');
mkdirSync(output, { recursive: true });

const differences: string[] = [];
const approvedRecords = [
  ...realmEnrichment,
  ...subrealmEnrichment,
  ...bioregionEnrichment,
  ...ecoregionEnrichment,
].filter(({ targetId }) => {
  const state = enrichmentCoverage[targetId];
  return state === 'reviewed' || state === 'published';
});
const candidatesByReferenceId = new Map<string, Set<string>>();
const addCandidate = (referenceId: string, partitionId: string | undefined) => {
  if (!partitionId) return;
  const candidates = candidatesByReferenceId.get(referenceId) ?? new Set<string>();
  candidates.add(partitionId);
  candidatesByReferenceId.set(referenceId, candidates);
};
for (const record of approvedRecords) {
  const partitionId = ecoregionPartitionByTargetId[record.targetId];
  for (const speciesId of record.characteristicSpeciesIds ?? [])
    addCandidate(speciesId, partitionId);
  for (const countryId of record.countryIds ?? [])
    addCandidate(`country:${countryId}`, partitionId);
}
const ownership = Object.fromEntries(
  [...candidatesByReferenceId]
    .sort(([left], [right]) => left.localeCompare(right))
    .map(([referenceId, candidates]) => [
      referenceId,
      livingCompositionPartitionByTaxonId[referenceId] ?? [...candidates].sort()[0]!,
    ]),
);
const ownershipPath = join(root, '..', 'content', 'ecological-reference-ownership.ts');
const generatedOwnership = `// Generated by generate-content-partitions.mts. Do not edit.\nexport const ecologicalReferencePartitionById: Readonly<Record<string, string>> = Object.freeze(${JSON.stringify(ownership, null, 2)});\n`;
if (check) {
  if (!existsSync(ownershipPath) || readFileSync(ownershipPath, 'utf8') !== generatedOwnership)
    differences.push('ecological-reference-ownership');
} else writeFileSync(ownershipPath, generatedOwnership, 'utf8');

const { buildEcoregionPartition } = await import('../content/build-ecoregion-partition');
const { ecoregionContentPartitionIds } = await import('../content/ecoregion-content-provider');
for (const partitionId of ecoregionContentPartitionIds) {
  const path = join(output, `${partitionId}.generated.ts`);
  const generated = `// Generated by generate-content-partitions.mts. Do not edit.\nimport type { TaxonomyContentBundle } from '../../../../taxonomy/public-api';\n\nexport const contentBundle = ${JSON.stringify(buildEcoregionPartition(partitionId), null, 2)} as const satisfies TaxonomyContentBundle;\n`;
  if (check) {
    if (!existsSync(path) || readFileSync(path, 'utf8') !== generated)
      differences.push(partitionId);
  } else writeFileSync(path, generated, 'utf8');
}

if (differences.length) {
  console.error(`Generated content partitions are stale: ${differences.join(', ')}`);
  process.exitCode = 1;
} else if (check)
  console.log(`Verified ${ecoregionContentPartitionIds.length} content partitions.`);
else console.log(`Generated ${ecoregionContentPartitionIds.length} content partitions.`);
